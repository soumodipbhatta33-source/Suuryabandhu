                    ┌─────────────────┐
                    │ Arduino / IoT   │
                    │ Controller      │
                    └─────────────────┘
                             │
              ┌──────────────┼──────────────┐
              │              │              │
              ▼              ▼              ▼
        Household       Solar Input     Status LEDs
          Loads
              │              │
              └──────────────┼──────────────┘
                             ▼
                       LCD Display
                             │
                             ▼
                    Monitoring System
                             │
                             ▼
                    Web Dashboard
                             │
            ┌────────────────┼────────────────┐
            ▼                ▼                ▼
       Load Usage       Solar Usage       Grid Usage
            │                │                │
            └────────────────┼────────────────┘
                             ▼
                    Billing & Savings
                             │
                             ▼
                     Fault Monitoring
